{
  "name": "@bullebrowser/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BulleBrowser for iOS and Android",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "native:init": "node scripts/prepare-native.mjs",
    "native:sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
