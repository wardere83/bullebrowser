  "dependencies": {
    "@bullebrowser/agent-core": "workspace:*",
    "@bullebrowser/brand-tokens": "workspace:*",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/android": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "engines": { "node": ">=22" }
